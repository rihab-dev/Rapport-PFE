{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler rapport.pdf",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-g",
                "-f",
                "rapport.tex"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$latex"
            ]
        }
    ]
}